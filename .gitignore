# images/ (manually-placed source photos) is tracked -- these are the
# actual stimuli, not reproducible if lost, and each is well under 1MB.
#
# images_processed/ is NOT tracked: it's a deterministic derivative of
# images/ (prepare_stimuli.py regenerates it byte-for-byte from the same
# root seed and source files), and it's the one place hashed-but-still-
# recognizable copies of the real photos would otherwise sit twice in git.
images_processed/

# Rendered figures are regenerable from data/*.jsonl by analyze.py.
# figures are small and are the deliverable; keep them
#results/*.png
#results/*.svg

__pycache__/
*.pyc
.venv/

# data/*.jsonl IS tracked, as of 2026-08-15. It used not to be: the original
# files carried the full `raw_response` dump on every row, which put them at
# ~1-1.5MB each, over the 1MB-per-file line in CLAUDE.md.
#
# That decision cost us the originals. They were deleted during the move to
# this repository and, being untracked, existed nowhere else -- rebuilt from
# transcripts/ by rebuild_data_from_transcripts.py. The rebuilt rows drop
# raw_response and usage, which brings the largest file to 596KB, comfortably
# under the line. There is no longer a reason to keep the record of record out
# of version control.
data/*.jsonl.bak

# results/ (analysis tables + figures) IS tracked -- small, and it is the
# actual deliverable. testruns/ likewise.
!results/*.csv
!testruns/**

# macOS cruft
.DS_Store
# This archived run's raw logs are 2MB+ per file, over the size line in the
# root CLAUDE.md. Smaller archived logs under testruns/ stay tracked -- the
# rule is the file size, not the directory. Its transcripts/ are tracked, so
# the run is still readable without the raw responses.
testruns/announced-horizon-n10-2026-08-15/*.jsonl
